# cmake -DLIB=<library> -DLIMIT=<bytes> -DSIZE=<size tool> -P check_lib_size.cmake: warns when the sections
# a library loads (those with an address) pass LIMIT, well before code and data outgrow 32-bit offsets
# (2 GiB)
execute_process(COMMAND ${SIZE} -A ${LIB} OUTPUT_VARIABLE sections RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(WARNING "${SIZE} -A ${LIB} failed")
    return()
endif()
string(REPLACE "\n" ";" lines "${sections}")
set(loaded 0)
foreach(line ${lines})
    if(line MATCHES "^[^ ]+ +([0-9]+) +([0-9]+)$" AND NOT CMAKE_MATCH_2 EQUAL 0)
        math(EXPR loaded "${loaded} + ${CMAKE_MATCH_1}")
    endif()
endforeach()
if(loaded GREATER LIMIT)
    get_filename_component(name ${LIB} NAME)
    message(WARNING "${name} loads ${loaded} bytes, more than ${LIMIT}: raise LEAFLIB_COUNT")
endif()
